# Copia este archivo como .env.local cuando Supabase esté disponible.
# El MVP permanece en modo demo local si estas variables están ausentes.
VITE_SUPABASE_URL=
# Preferida para proyectos nuevos de Supabase.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Compatibilidad con proyectos que todavía muestran la clave anon.
VITE_SUPABASE_ANON_KEY=
# URL pública usada en enlaces de invitación y recuperación de contraseña.
VITE_PUBLIC_APP_URL=https://evaluedu.elmer-yale99-torrez.chatgpt.site
